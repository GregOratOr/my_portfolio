# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vscode/settings.json

# ---------------------------------------------------------------------------
# Personal content. Never committed -- `npm run setup:content` recreates these
# from the *.example.ts templates, and CI overlays the real ones from the
# private content repo. See README "Content & privacy".
# ---------------------------------------------------------------------------
src/content/profile.ts
src/content/skills.ts
src/content/experience.ts
src/content/projects.ts

# Personal assets
public/resume.pdf
public/profile.*
public/images/logos/
# Ignore the contents, not the directory itself -- git cannot re-include a file
# whose parent directory is excluded, and placeholder.svg must stay committed.
public/images/projects/*
!public/images/projects/placeholder.svg
public/images/portrait.*
public/og-image.*
